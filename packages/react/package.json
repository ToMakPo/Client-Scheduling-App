{
	"name": "@thunguard/scheduler-react",
	"description": "React components and hooks for scheduling built on @thunguard/scheduler-core",
	"version": "0.1.0",
	"author": "Makai Post <post.makai@example.com>",
	"license": "MIT",
	"keywords": [
		"scheduling",
		"appointment",
		"calendar",
		"booking",
		"react",
		"components"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ToMakPo/Client-Scheduling-App.git",
		"directory": "packages/react"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup src/index.ts --format cjs,esm --dts --clean --external react --external react-dom --external @thunguard/scheduler-core",
		"dev": "tsup src/index.ts --format cjs,esm --dts --watch --external react --external react-dom --external @thunguard/scheduler-core",
		"test": "echo \"Tests to be implemented\"",
		"clean": "rm -rf dist"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"@thunguard/scheduler-core": "0.1.0"
	},
	"devDependencies": {
		"@types/react": "^18.2.48",
		"@types/react-dom": "^18.2.18",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"tsup": "^8.0.1",
		"typescript": "^5.3.3"
	}
}